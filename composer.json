{
    "name": "meirdick/auto-search-chips",
    "description": "Natural-language search that becomes removable filter chips over any Eloquent model. Deterministic rules engine by default; optional AI refine through Cloudflare System One or laravel/ai. Livewire, Blade, React, Vue and Svelte components.",
    "keywords": [
        "laravel",
        "search",
        "filters",
        "chips",
        "natural-language",
        "eloquent",
        "livewire",
        "inertia",
        "ai",
        "workers-ai"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Meir Dick",
            "homepage": "https://meirdick.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0||^13.0",
        "illuminate/cache": "^12.0||^13.0",
        "illuminate/console": "^12.0||^13.0",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/routing": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "illuminate/view": "^12.0||^13.0"
    },
    "suggest": {
        "livewire/livewire": "Required for the <livewire:search-chips> component (^3.0 or ^4.0).",
        "laravel/ai": "Required for the chat engine (engine: ai).",
        "laravel/scout": "Models that use Searchable send their keyword text through Scout.",
        "meirdick/laravel-cf-workersai": "Used for the System One transport when installed (retries, AI Gateway)."
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/ai": "^1.0",
        "laravel/pint": "^1.18",
        "laravel/scout": "^10.0||^11.0",
        "livewire/livewire": "^3.0||^4.0",
        "meilisearch/meilisearch-php": "^1.0",
        "meirdick/laravel-cf-workersai": "^1.3",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.0||^5.0",
        "typesense/typesense-php": "^4.9||^5.0"
    },
    "autoload": {
        "psr-4": {
            "Meirdick\\SearchChips\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Meirdick\\SearchChips\\Tests\\": "tests",
            "Workbench\\App\\": "workbench/app",
            "Workbench\\Database\\Factories\\": "workbench/database/factories",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders"
        }
    },
    "scripts": {
        "test": "pest --compact",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Meirdick\\SearchChips\\SearchChipsServiceProvider"
            ],
            "aliases": {
                "SearchChips": "Meirdick\\SearchChips\\Facades\\SearchChips"
            }
        }
    },
    "prefer-stable": true,
    "homepage": "https://github.com/meirdick/auto-search-chips"
}
